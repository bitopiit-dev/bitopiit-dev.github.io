# Port the API listens on (Render sets this automatically)
PORT=8080

# MongoDB Atlas connection string. Leave empty to use an in-memory store (data is lost on restart).
MONGODB_URI=

# Front-end origins allowed to call the API, comma separated.
# Example: https://bitopiit-dev.github.io,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Long random string. Needed to read contact messages: GET /api/messages with header "Authorization: Bearer <token>"
ADMIN_TOKEN=change-me-to-a-long-random-string

# Email notification for new contact messages (optional), sent through Resend's HTTPS API.
# Render's free plan blocks SMTP, so Gmail/SMTP won't work there.
# Create a key at resend.com > API Keys. NOTIFY_EMAIL must be the email you signed up to Resend with.
RESEND_API_KEY=
NOTIFY_EMAIL=
# Only change this after verifying your own domain in Resend
NOTIFY_FROM=Portfolio <onboarding@resend.dev>
